# ─────────────────────────────────────────────
# Database (mysql2 — pure JS, no binary engine)
# ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=dbuser
DB_PASSWORD=dbpassword
DB_NAME=trakovo

# Optional shared-host tuning/diagnostics. Defaults shown below.
# Keep the pool conservative on cPanel; accepted connection limit range is 1-20.
DB_CONNECTION_LIMIT=5
# Log and retain recent query diagnostics at or above this duration (milliseconds).
DB_SLOW_QUERY_MS=250

# ─────────────────────────────────────────────
# Admin panel (server-side only)
# ─────────────────────────────────────────────

# Secret used to sign admin session tokens (generate with: openssl rand -hex 32)
ADMIN_JWT_SECRET=change_this_to_a_long_random_string

# Secret used to sign vendor session tokens (generate with: openssl rand -hex 32)
VENDOR_JWT_SECRET=change_this_to_another_long_random_string

# Secret used to sign driver session tokens (generate with: openssl rand -hex 32)
DRIVER_JWT_SECRET=change_this_to_a_driver_secret

# ─────────────────────────────────────────────
# Admin credentials (simple single-user login)
# ─────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# ─────────────────────────────────────────────
# Cookie security
# Set to "false" if your site runs on HTTP only (e.g. behind Cloudflare Flexible SSL,
# or while HTTPS is not yet configured on the server).
# Remove this line (or set to "true") once HTTPS is working end-to-end.
# ─────────────────────────────────────────────
COOKIE_SECURE=false

# ─────────────────────────────────────────────
# Email (SMTP)
# Works with Gmail App Passwords, Outlook, SendGrid, Mailgun, etc.
# The notification address itself is set via Admin → Settings
# ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@email.com
SMTP_PASS=your_app_password
SMTP_FROM="Trakovo <bookings@yourdomain.com>"

# ─────────────────────────────────────────────
# Email — Microsoft 365 / Outlook (optional)
# Takes priority over SMTP when set.
# Configure via Azure App Registrations.
# ─────────────────────────────────────────────
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# MS_TENANT_ID=

# ─────────────────────────────────────────────
# File uploads
# Absolute path to the directory where uploaded files are stored.
# Must be outside the app folder so uploads survive redeployments.
# Leave blank to use ./uploads relative to project root.
# ─────────────────────────────────────────────
UPLOAD_DIR=

# ─────────────────────────────────────────────
# Site lock modes (only one should be true at a time)
#
# DEVELOPMENT_MODE — "coming soon / preview" copy. Use while building the site.
# MAINTENANCE_MODE — "under maintenance" copy. Use for temporary downtime.
#
# Visitors must enter MAINTENANCE_PASSWORD to access the site while locked.
# Set both to false (or remove) to disable locking entirely.
# ─────────────────────────────────────────────
DEVELOPMENT_MODE=false
MAINTENANCE_MODE=false
MAINTENANCE_PASSWORD=change_this_preview_password

# ─────────────────────────────────────────────
# Site
# ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_NAME=Trakovo
NEXT_PUBLIC_ADMIN_NAME=Hire Manager
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ─────────────────────────────────────────────
# Cron authentication
# Used to protect /api/cron/email-sequences — set a long random string
# cPanel cron: 0 7 * * * curl -s -X POST https://yourdomain.com/api/cron/email-sequences -H "Authorization: Bearer YOUR_SECRET"
# ─────────────────────────────────────────────
CRON_SECRET=change_this_to_a_long_random_string

# ─────────────────────────────────────────────
# Mapbox (for /book taxi flow)
# Get a free public token at mapbox.com — create a public access token
# ─────────────────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=pk.ey...

# ─────────────────────────────────────────────
# Web Push Notifications (VAPID)
# Generate new keys with: npx web-push generate-vapid-keys
# ─────────────────────────────────────────────
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@yourdomain.com
